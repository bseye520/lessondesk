# 复制成 .env 后修改。SECRET_KEY 必须换成自己的随机值：
#   openssl rand -hex 32
SECRET_KEY=change-me-please

# 时区
TZ=Asia/Shanghai

# 公网（带 CF-Connecting-IP 的请求）强制 HTTPS 跳转；设 0 关闭
FORCE_HTTPS=1

# HSTS max-age（秒），0 = 不发送 HSTS 头
HSTS_MAX_AGE=15552000

# 是否采信反向代理注入的客户端 IP 头（CF-Connecting-IP / X-Real-IP / X-Forwarded-For）
# 只在「前面确实有可信反代」时开；容器端口直接暴露公网时建议设 0
TRUST_PROXY_HEADERS=1
